# 복사해서 backend/.env로 쓴다. .env는 커밋하지 않는다.
ENV=local
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase (장세찬이 프로젝트 생성 후 공유)
SUPABASE_URL=
# 레거시 HS256 시크릿을 쓸 때만. 비우면 JWKS로 검증한다.
SUPABASE_JWT_SECRET=
# 로컬 전용: X-Dev-User 헤더로 로그인 없이 테스트
AUTH_DEV_BYPASS=true

MOCK_CHARACTER=true

# 외부 API 키 (서버에만 둔다)
GEMINI_API_KEY=
MESHY_API_KEY=

WORKER_ID=worker-local
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
BLENDER_SCRIPTS_DIR=../blender
