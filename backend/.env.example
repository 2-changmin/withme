# 복사해서 backend/.env로 쓴다. .env는 커밋하지 않는다.
ENV=local
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase (장세찬이 프로젝트 생성 후 공유)
SUPABASE_URL=
# 레거시 HS256 시크릿을 쓸 때만. 비우면 JWKS로 검증한다.
SUPABASE_JWT_SECRET=
# 로컬 전용: X-Dev-User 헤더로 로그인 없이 테스트
AUTH_DEV_BYPASS=true

MOCK_CHARACTER=true

# 외부 API 키 (서버에만 둔다)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# 실제 Gemini 호출(유료)은 false일 때만. 담당자(윤승희)가 아니면 true로 둔다.
MOCK_GEMINI=true
MESHY_API_KEY=
# true면 Meshy를 호출하지 않는다 (크레딧 소모 없음). 실제 생성을 테스트할 때만 false로 바꾼다.
MOCK_MESHY=true
# 목업일 때 저장할 GLB 경로. 비우면 삼각형 하나짜리 GLB. 리깅까지 이어서 확인하려면 강아지 GLB를 넣는다.
MOCK_MESHY_GLB=
# 무지개다리 편지 답장 (#74). true면 Gemini 없이 정해진 답장을 쓴다.
MOCK_LETTER=true
GEMINI_TEXT_MODEL=gemini-2.5-flash

# 미디어 저장소 (#30). local: backend/.media 폴더 (ENV=local 전용) / supabase: 비공개 버킷 media
STORAGE_BACKEND=local
# supabase일 때만. 서버 전용 키라 앱·저장소에 절대 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
SIGNED_URL_SECONDS=300

WORKER_ID=worker-local
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
BLENDER_SCRIPTS_DIR=../blender
